layout {
    # Theme: Catppuccin Latte - peach
    background-color "#eff1f5"

    focus-ring {
        active-color "#fe640b"
        inactive-color "#ccd0da"
        urgent-color "#d20f39"
    }

    border {
        active-color "#fe640b"
        inactive-color "#ccd0da"
        urgent-color "#d20f39"
    }

    shadow {
        color "#dce0e84d"
        inactive-color "#eff1f54d"
    }

    tab-indicator {
        active-color "#fe640b"
        inactive-color "#ccd0da"
        urgent-color "#d20f39"
    }

    insert-hint {
        color "#fe640b"
    }
}

recent-windows {
    highlight {
        active-color "#fe640b"
        urgent-color "#d20f39"
    }
}

overview {
    backdrop-color "#e6e9ef"
    workspace-shadow {
        color "#dce0e84d"
        inactive-color "#eff1f54d"
    }
}
