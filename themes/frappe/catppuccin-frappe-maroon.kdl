layout {
    # Theme: Catppuccin Frappé - maroon
    background-color "#303446"

    focus-ring {
        active-color "#ea999c"
        inactive-color "#414559"
        urgent-color "#e78284"
    }

    border {
        active-color "#ea999c"
        inactive-color "#414559"
        urgent-color "#e78284"
    }

    shadow {
        color "#2326344d"
        inactive-color "#3034464d"
    }

    tab-indicator {
        active-color "#ea999c"
        inactive-color "#414559"
        urgent-color "#e78284"
    }

    insert-hint {
        color "#ef9f76"
    }
}

recent-windows {
    highlight {
        active-color "#ea999c"
        urgent-color "#e78284"
    }
}

overview {
    backdrop-color "#292c3c"
    workspace-shadow {
        color "#2326344d"
        inactive-color "#3034464d"
    }
}
