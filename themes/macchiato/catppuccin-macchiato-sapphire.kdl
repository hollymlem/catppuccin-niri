layout {
    # Theme: Catppuccin Macchiato - sapphire
    background-color "#24273a"

    focus-ring {
        active-color "#7dc4e4"
        inactive-color "#363a4f"
        urgent-color "#ed8796"
    }

    border {
        active-color "#7dc4e4"
        inactive-color "#363a4f"
        urgent-color "#ed8796"
    }

    shadow {
        color "#1819264d"
        inactive-color "#24273a4d"
    }

    tab-indicator {
        active-color "#7dc4e4"
        inactive-color "#363a4f"
        urgent-color "#ed8796"
    }

    insert-hint {
        color "#f5a97f"
    }
}

recent-windows {
    highlight {
        active-color "#7dc4e4"
        urgent-color "#ed8796"
    }
}

overview {
    backdrop-color "#1e2030"
    workspace-shadow {
        color "#1819264d"
        inactive-color "#24273a4d"
    }
}
